# spawn-scene v2 yaml objects
vg-pollen:
  feetPosition: {attach: camera, depth: 0, x: 0, y: 0}
  fx: {script: "fx follow=camera\npop pollen n=?mobile:60|140 wrap=24 on=box(<24,10,24>) size=.02..0.04 v=sdir()*.15 acc=curl(.25)*.5+wind() col=hdr(1.3,1.25,1) a=.55*flick(.7,.4) sz=$size r=sprite(soft-disc,add)\npop petal n=?mobile:14|30 wrap=24 on=box(<24,10,24>) size=.06..0.1 v=<.3,-.35,.1> acc=curl(.4)*.8+wind() col=<1,.78,.86> a=.85 rot=spin(1.2) sz=$size r=sprite(soft-disc,alpha)"}
  id: vg-pollen
  tags: [verdant-glade]
