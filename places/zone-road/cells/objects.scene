# spawn-scene v2 yaml objects
or-motes:
  feetPosition: {attach: camera, depth: 0, x: 0, y: 0}
  fx: {script: "fx follow=camera\npop motes n=?mobile:40|90 wrap=24 on=box(<24,8,24>) size=.02..0.04 v=sdir()*.12 acc=curl(.25)*.4+wind() col=hdr(1.1,1.1,1.05) a=.4*flick(.6,.4) sz=$size r=sprite(soft-disc,add)"}
  id: or-motes
  tags: [old-road]
