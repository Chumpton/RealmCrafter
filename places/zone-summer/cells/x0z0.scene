  fx: {script: "fx follow=camera\npop pollen n=?mobile:40|90 at=box(<26,9,26>) life=6..10 v=<.25,.05,.1>+sdir()*.1 size=.025..0.05 acc=curl(.4)*.25+wind()*.3 col=hdr(1.6,1.45,.9) a=0>.15:.8>.85:.8>0 sz=$size r=sprite(soft-disc,add) wrap=13;5;13\npop seeds n=?mobile:8|18 at=box(<30,8,30>) life=8..14 v=<.5,.08,.2> size=.07..0.11 acc=curl(.3)*.4+wind()*.5+buoy(.05) col=<.97,.96,.92> a=0>.1:.9>.85:.9>0 sz=$size rot=spin(.4) r=sprite(soft-disc,alpha) wrap=15;4;15"}
